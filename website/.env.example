# OpenNolan waitlist — Resend config. Copy to .env.local and fill in.
# All free on Resend's free tier. See README.md for the 10-min setup.

# Required — your Resend API key (API Keys → Create, with sending access)
RESEND_API_KEY=re_xxxxxxxx

# Required to store signups — the Audience ID (Audiences → Create → copy ID)
RESEND_AUDIENCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Required to send the confirmation — must be on a domain you've VERIFIED in Resend
WAITLIST_FROM_EMAIL=OpenNolan <waitlist@opennolan.app>

# Optional — reply-to address for the confirmation email
# WAITLIST_REPLY_TO=hello@opennolan.app

# Optional — get a heads-up email to yourself on every new signup
# WAITLIST_NOTIFY_EMAIL=you@example.com
