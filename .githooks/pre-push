#!/bin/sh
# Account guard — pushes to this public personal repo must authenticate as het8802.
#
# The git credential helper is `gh auth git-credential`, which always hands back
# whichever gh account is ACTIVE — regardless of the remote URL. (Verified: passing
# username=het8802 to the helper returns nothing; gh ignores it.) So the only place
# to catch a work-account push is right here.
#
# It switches the account and then BLOCKS, telling you to run the push again.
# That is not timidity — git authenticates during ref discovery, which happens
# BEFORE pre-push runs, so the credential for the current push is already chosen
# by the time this hook executes. Letting the push continue after switching would
# still use the old account. Switch now, succeed on the retry.
#
# Two more honest limits:
#   1. `gh auth switch` is GLOBAL. After this runs, every repo and terminal uses
#      het8802 until switched back.
#   2. git has no post-push hook, so this cannot restore the previous account
#      afterwards. The message below says how.
#
# Enabled by:  git config core.hooksPath .githooks

WANT='het8802'

if command -v gh >/dev/null 2>&1; then
	ACTIVE="$(gh auth status --active 2>/dev/null |
		sed -n 's/.*Logged in to github.com account \([^ ]*\).*/\1/p')"

	if [ -n "$ACTIVE" ] && [ "$ACTIVE" != "$WANT" ]; then
		if ! gh auth switch --user "$WANT" >/dev/null 2>&1; then
			cat >&2 <<EOF

  ✗ PUSH BLOCKED — active GitHub account is '$ACTIVE', not '$WANT'

  Auto-switch failed. Is '$WANT' still authenticated?

      gh auth status
      gh auth login --hostname github.com

EOF
			exit 1
		fi

		cat >&2 <<EOF

  ⚠ PUSH STOPPED — gh account was '$ACTIVE', switched to '$WANT'

    Run the same push again; it will go through as $WANT.
    (git picks its credential before this hook runs, so the switch cannot
     apply to the push already in flight.)

    This switch is GLOBAL. Every other repo — tenant-manager included — now
    also uses $WANT until you switch back:

        gh auth switch --user $ACTIVE

EOF

		exit 1
	fi
fi

# The account is correct. Run the deterministic pre-review gate before upload.
ROOT="$(git rev-parse --show-toplevel)"
REMOTE_URL="${2:-}"
if [ -z "$REMOTE_URL" ] && [ -n "${1:-}" ]; then
	REMOTE_URL="$(git remote get-url "$1" 2>/dev/null || true)"
fi
case "$REMOTE_URL" in
	https://github.com/*) REPO_SLUG="${REMOTE_URL#https://github.com/}" ;;
	git@github.com:*) REPO_SLUG="${REMOTE_URL#git@github.com:}" ;;
	ssh://git@github.com/*) REPO_SLUG="${REMOTE_URL#ssh://git@github.com/}" ;;
	*) REPO_SLUG="" ;;
esac
REPO_SLUG="${REPO_SLUG%.git}"
echo "  → running full repository gate before push" >&2
"$ROOT/scripts/dev" test full </dev/null || exit $?

# A review cannot exist until GitHub has seen the commit, so this is a courtesy
# warning only. Branch protection owns the authoritative review-current gate.
while read -r local_ref local_sha remote_ref remote_sha; do
	[ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
	[ -z "$REPO_SLUG" ] && continue
	state="$(gh api "repos/$REPO_SLUG/commits/$local_sha/status" \
		--jq '.statuses[] | select(.context == "review-current") | .state' \
		2>/dev/null | head -n 1)"
	if [ "$state" != "success" ]; then
		cat >&2 <<EOF

  ⚠ no current cross-provider review is recorded for $local_sha
    Push is allowed so GitHub can receive the SHA. Request review before merge.

EOF
	fi
done

exit 0
