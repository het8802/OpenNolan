{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/templates/template",
  "title": "Reel Template",
  "description": "A reusable, parametrized reel structure. template_apply fills the slots with the agent's/user's assets and emits a valid edit_decisions artifact.",
  "type": "object",
  "required": ["version", "name", "slots"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "aspect_ratio": { "type": "string", "description": "e.g. 9:16, 1:1, 16:9" },
    "target_seconds": { "type": "number", "minimum": 0 },
    "render_runtime": { "type": "string", "enum": ["remotion", "hyperframes", "ffmpeg"] },
    "renderer_family": {
      "type": "string",
      "description": "Creative grammar; must be a value the edit_decisions schema + RENDERER_FAMILY_MAP accept (e.g. social-reel)."
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "description": "Ordered clip slots. Each becomes one cut in the emitted edit_decisions.",
      "items": {
        "type": "object",
        "required": ["slot_id", "kind", "seconds"],
        "properties": {
          "slot_id": { "type": "string" },
          "kind": { "type": "string", "enum": ["video", "image"] },
          "seconds": { "type": "number", "minimum": 0.1, "description": "On-timeline duration of this slot" },
          "transition_in": { "type": "string", "description": "e.g. fade, dissolve, cut, wipe" },
          "transition_duration": { "type": "number", "minimum": 0 },
          "animation": { "type": "string", "description": "Motion for image stills (e.g. ken-burns-slow-zoom)" }
        },
        "additionalProperties": false
      }
    },
    "music": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "volume": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.7 },
        "ducking": { "type": "boolean", "default": true }
      },
      "additionalProperties": false
    },
    "subtitles": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "style": { "type": "string", "description": "sentence, word-by-word, karaoke" },
        "position": { "type": "string", "enum": ["top-center", "bottom-center", "center"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
