# OpenNolan - Environment Variables
# Copy this to .env and fill in your keys.
#
# Every key is OPTIONAL — OpenNolan runs with zero keys (local Piper TTS +
# FFmpeg + free stock media). Add keys to unlock more providers. The tool
# registry's `install_instructions` are the authoritative source for what each
# key unlocks; this file is the quick-start list.

# --- Agent runtime (the LLM that drives the pipeline) ---
CLAUDE_CODE_OAUTH_TOKEN=     # Preferred: drives the Mission Control agent via your Claude Code subscription (no per-token billing)
ANTHROPIC_API_KEY=           # Alternative: per-token Anthropic API billing (takes precedence over the OAuth token if set)

# --- Image + video gateway ---
FAL_KEY=                     # FLUX images, Google Veo video, Kling video, MiniMax video, Recraft images
                             # Get one at https://fal.ai/dashboard/keys
                             # (FAL_AI_API_KEY is also accepted as an alias)

# --- Google (one key unlocks image gen + TTS) ---
GOOGLE_API_KEY=              # Google Imagen images, Google Cloud TTS (700+ voices, 50+ languages)
                             # Get one at https://aistudio.google.com/apikey
                             # (GEMINI_API_KEY is also accepted as an alias)
# GOOGLE_APPLICATION_CREDENTIALS=  # Optional: path to a Google Cloud service-account JSON (alt auth for Cloud TTS)

# --- Image Generation (direct provider API) ---
BFL_API_KEY=                 # Black Forest Labs FLUX direct API — alternative to fal.ai routing (see the bfl-api skill)
                             # Get one at https://dashboard.bfl.ai

# --- Voice ---
ELEVENLABS_API_KEY=          # TTS narration, music generation, sound effects
OPENAI_API_KEY=              # OpenAI TTS fallback and DALL-E image generation
XAI_API_KEY=                 # Grok image generation/editing and Grok video generation
DOUBAO_SPEECH_API_KEY=       # Volcengine Doubao Speech TTS (new console API Key)
DOUBAO_SPEECH_VOICE_TYPE=    # Default Doubao speaker/voice type, e.g. zh_female_vv_uranus_bigtts
# Piper local voices do not require env vars; install `piper-tts` via pip

# --- Music & Sound ---
SUNO_API_KEY=                # Suno AI music generation (full songs, instrumentals, any genre)
FREESOUND_API_KEY=           # Freesound — free CC-licensed music & sound-effect search
                             # Get one at https://freesound.org/apiv2/apply/

# --- Video Generation ---
HEYGEN_API_KEY=              # HeyGen API (VEO, Sora, Runway, Kling, Seedance via single key)
RUNWAY_API_KEY=              # Runway Gen-4 (direct API, alternative to fal.ai routing)
                             # (RUNWAYML_API_SECRET is also accepted as an alias)
HIGGSFIELD_API_KEY=          # Higgsfield Cloud video — key half of the credential pair
HIGGSFIELD_API_SECRET=       # Higgsfield Cloud video — secret half
                             # (or set HIGGSFIELD_KEY="key:secret" as a single combined value instead)
VIDEO_GEN_LOCAL_ENABLED=     # Set to "true" for local video gen (needs GPU + diffusers)
VIDEO_GEN_LOCAL_MODEL=       # Local model: wan2.1-1.3b, wan2.1-14b, hunyuan-1.5, ltx2-local, cogvideo-5b
MODAL_LTX2_ENDPOINT_URL=     # Modal self-hosted LTX-2 endpoint (optional)

# --- Stock Media ---
PEXELS_API_KEY=              # Pexels stock footage/images (free)
PIXABAY_API_KEY=             # Pixabay stock footage/images (free)
UNSPLASH_ACCESS_KEY=         # Unsplash stock images (free developer key)
COVERR_API_KEY=              # Coverr stock video — optional, raises rate limits (Pro tier)
VIDEVO_API_KEY=              # Videvo stock video search — optional
POND5_API_KEY=               # Pond5 public-domain stock — optional, higher limits + full API access
NARA_API_KEY=                # Nara stock video — optional, higher rate limits

# --- Web / Search ---
FIRECRAWL_API_KEY=           # Firecrawl — webpage screenshots + HD web image search (1 credit/page)
                             # Get one at https://www.firecrawl.dev/app/api-keys

# --- Analysis ---
HF_TOKEN=                    # HuggingFace token — enables speaker diarization in transcriber
REPLICATE_API_TOKEN=         # Replicate — Content Signal virality scorer + hosted community models
                             # Get one at https://replicate.com/account/api-tokens

# --- Avatar (local installs) ---
# WAV2LIP_PATH=              # Path to cloned Wav2Lip repo (for lip sync)
# SADTALKER_PATH=            # Path to cloned SadTalker repo (for talking head avatars)
